# Project environment
PROJECT_ENV=local
AIRFLOW_UID=50000

# Airbyte OSS
# abctl exposes Airbyte at http://localhost:8000 by default.
# Inside Astro containers, host.docker.internal reaches services on the host.
# Docker Desktop provides that hostname. Keep Astro on Docker, not Podman.
AIRBYTE_API_BASE_URL=http://host.docker.internal:8000/api/public/v1
AIRBYTE_API_MODE=public
# Username and password from `abctl local credentials` (also the Airbyte UI login).
AIRBYTE_USERNAME=
AIRBYTE_PASSWORD=
# Airbyte connection id. After setting this, run `astro dev restart`.
AIRBYTE_CONNECTION_ID=
AIRBYTE_POLL_SECONDS=15
AIRBYTE_TIMEOUT_SECONDS=1800

# MinIO / S3-compatible landing zone
MINIO_ENDPOINT=http://host.docker.internal:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_REGION=us-east-1
MINIO_BUCKET=landing-zone
MINIO_AIRBYTE_PREFIX=weather_observations

# MotherDuck / DuckDB
# Token from MotherDuck UI → organization menu → Settings → Create token.
MOTHERDUCK_TOKEN=
# Must match a database that already exists in your MotherDuck account (UI → Databases).
MOTHERDUCK_DATABASE=my_db
MOTHERDUCK_SCHEMA_BRONZE=bronze
MOTHERDUCK_SCHEMA_SILVER=silver
MOTHERDUCK_SCHEMA_GOLD=gold
